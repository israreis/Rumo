{
  "name": "Rumo Trip — diário de bordo",
  "short_name": "Rumo Trip",
  "description": "Planeje roteiro, passagens, hospedagem, orçamento e gastos das suas viagens.",
  "lang": "pt-BR",
  "id": "/trips",
  "start_url": "/trips?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "portrait",
  "background_color": "#f3eee4",
  "theme_color": "#f3eee4",
  "categories": ["travel", "productivity"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Minhas viagens", "url": "/trips", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Nova viagem", "url": "/trips/new", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
